{
  "name": "promo-tracker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "api": "tsx src/app/api.ts",
    "bot": "tsx src/app/bot.ts",
    "ui": "npm --prefix ui run dev",
    "ui:build": "npm --prefix ui run build",
    "ui:test": "npm --prefix ui test",
    "test": "touch prisma/test.db && DATABASE_URL=file:./test.db prisma migrate deploy && DATABASE_URL=file:./test.db vitest run",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^26.5.0",
    "@types/supertest": "^7.2.1",
    "prisma": "^6.19.3",
    "supertest": "^7.2.2",
    "tsx": "^4.23.13",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  },
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "grammy": "^1.46.0"
  }
}
