generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

enum UserRole {
  KAM
  PLM
  SUPERUSER
}

enum ReportingPeriodStatus {
  OPEN
  CLOSED
}

model User {
  id           Int      @id @default(autoincrement())
  email        String   @unique
  passwordHash String
  role         UserRole @default(KAM)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  partners UserPartner[]
  closedReportingPeriods ReportingPeriod[] @relation("ReportingPeriodClosedBy")
}

model Promo {
  id             String   @id @default(cuid())
  lob            String
  name           String
  normalizedName String
  startDate      DateTime
  endDate        DateTime
  prolongedAt    DateTime?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  partners PromoPartner[]

  @@unique([lob, normalizedName, startDate, endDate])
  @@index([startDate])
  @@index([endDate])
}

model Partner {
  id        String   @id @default(cuid())
  name      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  promos PromoPartner[]
  users  UserPartner[]
}

model UserPartner {
  userId    Int
  partnerId String
  createdAt DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  partner Partner @relation(fields: [partnerId], references: [id], onDelete: Cascade)

  @@id([userId, partnerId])
  @@index([partnerId])
}

model PromoPartner {
  id               String   @id @default(cuid())
  promoId          String
  partnerId        String
  rawEmailSubject  String?
  reportReceived   Boolean  @default(false)
  reportReceivedAt DateTime?
  firstReminderSentAt  DateTime?
  secondReminderSentAt DateTime?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  promo   Promo   @relation(fields: [promoId], references: [id], onDelete: Cascade)
  partner Partner @relation(fields: [partnerId], references: [id], onDelete: Cascade)

  @@unique([promoId, partnerId])
  @@index([partnerId])
  @@index([promoId])
}

model PromoProlongationOperation {
  id                        String   @id @default(cuid())
  fingerprint               String   @unique
  sourcePromoId             String
  sourceLob                 String
  sourceEndDate             DateTime
  requestedEndDate          DateTime
  resultKind                String
  resultTargetPromoId       String
  resultContinuationPromoId String?
  createdAt                 DateTime @default(now())

  associations PromoProlongationAssociationSnapshot[]

  @@index([sourcePromoId, requestedEndDate])
}

model PromoProlongationAssociationSnapshot {
  id                   String   @id @default(cuid())
  operationId          String
  sourcePromoPartnerId String
  partnerId            String
  rawEmailSubject      String?
  reportReceived       Boolean
  reportReceivedAt     DateTime?
  firstReminderSentAt  DateTime?
  secondReminderSentAt DateTime?
  createdAt            DateTime
  updatedAt            DateTime

  operation PromoProlongationOperation @relation(fields: [operationId], references: [id], onDelete: Cascade)

  @@unique([operationId, sourcePromoPartnerId])
  @@index([sourcePromoPartnerId])
}

model ReportingPeriod {
  id             String                @id @default(cuid())
  year           Int
  quarter        Int
  lob            String
  status         ReportingPeriodStatus @default(OPEN)
  closedAt       DateTime?
  closedByUserId Int?
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt

  closedBy User? @relation("ReportingPeriodClosedBy", fields: [closedByUserId], references: [id], onDelete: SetNull)

  @@unique([year, quarter, lob])
  @@index([status, year, quarter])
  @@index([closedByUserId])
}
